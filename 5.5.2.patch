+@pytest.mark.parametrize(
+    ("content", "expected_body"),
+    [
+        (":class: outer\n:::{note}\nbody\n:::", [":::{note}", "body", ":::"]),
+        (
+            ":class: outer\n::::{note}\nbody\n::::",
+            ["::::{note}", "body", "::::"],
+        ),
+        (
+            ":class: outer\n  :::{note}\nbody\n  :::",
+            ["  :::{note}", "body", "  :::"],
+        ),
+    ],
+)
+def test_colon_options_stop_at_colon_fence_variants(content, expected_body):
+    result = parse_directive_text(Note, "", content)
+    assert not result.warnings
+    assert result.options == {"class": ["outer"]}
+    assert result.body == expected_body
+    assert result.body_offset == 1
+
+
+def test_nested_colon_directive_option_block_has_inner_priority():
+    result = parse_directive_text(
+        Note,
+        "",
+        ":class: outer\n:::{note}\n:class: inner\ninner\n:::\nouter",
+    )
+    assert not result.warnings
+    assert result.options == {"class": ["outer"]}
+    assert result.body == [":::{note}", ":class: inner", "inner", ":::", "outer"]
+    assert result.body_offset == 1
+
+
+@pytest.mark.parametrize(
+    ("content", "expected_mode"),
+    [(":mode:\nbody", "auto"), (":mode: manual\nbody", "manual")],
+)
+def test_empty_option_value_default_handling(content, expected_mode):
+    result = parse_directive_text(DefaultingDirective, "", content)
+    assert not result.warnings
+    assert result.options == {"mode": expected_mode}
+    assert result.body == ["body"]
+    assert result.body_offset == 1
+
+
+def test_invalid_option_format_reports_line_and_preserves_body():
+    result = parse_directive_text(Note, "", ":class\n:::{note}\nbody\n:::", line=41)
+    assert result.options == {}
+    assert result.body == [":class", ":::{note}", "body", ":::"]
+    assert result.body_offset == 0
+    assert len(result.warnings) == 1
+    assert result.warnings[0].msg == "Invalid options format: expected ':' after key"
+    assert result.warnings[0].lineno == 41
+    assert result.warnings[0].type == MystWarnings.DIRECTIVE_OPTION
