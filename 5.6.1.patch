+
 def transform_tokens(token_stream):
     result = []
     for i, token in enumerate(token_stream):
         if token.type == 'heading':
             new_token = copy.deepcopy(token)
             new_token.content = token.content.upper()
+        # Bug 1: new_token 在非 heading 分支未定义 -> NameError
